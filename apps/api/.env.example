# Database
DATABASE_URL=postgresql://neondb_owner:npg_z8pIUus0FtvH@ep-sweet-mouse-ax2rnzc0-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email (SendGrid or SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com

# Anthropic (Claude LLM)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# Slot hold TTL (minutes)
SLOT_HOLD_TTL_MINUTES=5

# Notification retry
MAX_NOTIFICATION_RETRIES=3
